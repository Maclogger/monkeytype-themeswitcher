{
  "manifest_version": 3,
  "name": "Omarchy → Monkeytype theme sync",
  "version": "0.1.0",
  "description": "Switches the Monkeytype theme to match the current Omarchy theme, live.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://monkeytype.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
